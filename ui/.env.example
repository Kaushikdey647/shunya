# Dev: use Vite proxy (see vite.config.ts) so requests go to same origin.
VITE_API_BASE=/api

# Optional: override per machine in .env.local (gitignored by default in Vite templates).
# VITE_API_BASE=http://127.0.0.1:8000

# Production: full URL to API if served from another origin (requires CORS on API).
# VITE_API_BASE=https://api.example.com
