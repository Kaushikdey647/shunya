# Copy to ".env" in the repo root when running the API from a clone (never commit real secrets).
# Values here are merged with the process environment (env wins if set).

# --- Database (read by api/db.py from env, not SHUNYA_API_ prefixed) ---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shunya

# --- API (pydantic-settings prefix SHUNYA_API_) ---
# SHUNYA_API_DATABASE_URL=
# SHUNYA_API_ALPACA_ENABLED=0
# SHUNYA_API_TRADE_DESK_TOKEN=
# SHUNYA_API_OLLAMA_HOST=http://127.0.0.1:11434
# SHUNYA_API_OLLAMA_MODEL=llama3.2
# SHUNYA_API_WORKER_POLL_INTERVAL_SECONDS=1.0

# --- Alpaca (library + trade desk; not SHUNYA_API_ prefixed) ---
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=
# SHUNYA_ALPACA_PAPER=true

# --- CORS (read in api/main.py) ---
# SHUNYA_CORS_ORIGINS=http://localhost:5173

# --- Docker API entrypoint (see docker-compose.yml / Dockerfile) ---
# RUN_MIGRATIONS=1   # when set on the api container: run shunya-timescale migrate before uvicorn; use 0 to skip

# --- Docker Compose bootstrap service (runs before api; see docs/data_timescale.md) ---
# SHUNYA_COMPOSE_AUTO_BOOTSTRAP=1   # 0 = migrations only in bootstrap container, no Yahoo ingest scripts
# SHUNYA_COMPOSE_BOOTSTRAP_MIN_SP100_BARS=50   # probe: min distinct SP100 symbols with 1d yfinance OHLCV
